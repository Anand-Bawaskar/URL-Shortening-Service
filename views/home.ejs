<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        body{
            font-family: cursive ;
        }
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
</head>
<body>
    <h1>URL Shortner</h1>
    <% if (locals.id) { %>
     <p>URL Genrated:  http://localhost:8005/url/<%= id %></p>
    <% } %>
    <div>
        <form method="post" action="/url">
            <label>Enter URL</label>
            <input type="text" name="url" placeholder="https://www.example.com"/>
            <button type="submit">Genrate</button>
        </form>
    </div>
</body>
</html>